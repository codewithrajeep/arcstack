{
  "name": "arcstack",
  "version": "0.2.0",
  "description": "ArcStack - Backend Architecture Scaffolding Tool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arcstack": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"templates/**/*\" dist/",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "watch": "tsc -w"
  },
  "keywords": [
    "cli",
    "backend",
    "scaffolding",
    "typescript",
    "architecture",
    "nodejs"
  ],
  "author": "Rajeep",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "copyfiles": "^2.4.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "figlet": "^1.10.0",
    "fs-extra": "^11.3.3",
    "ora": "^9.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  }
}
